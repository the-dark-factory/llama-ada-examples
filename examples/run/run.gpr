--  llama-ada first light, built against the df_llama binding (its Linker_Options
--  pull in llama.cpp / ggml + the platform frameworks). Run from the crate root
--  so the model path resolves.

with "df_llama.gpr";

project Run is
   for Source_Dirs use (".");
   for Object_Dir  use "obj";
   for Exec_Dir    use "bin";
   for Main        use ("run.adb");
end Run;
